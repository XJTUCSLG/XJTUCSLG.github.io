# 构建产物
dist/
.astro/

# 依赖
node_modules/

# 本地 npm 缓存（本机全局缓存不可写时用的兜底）
.npm-cache/
.npm-cache-local/

# 日志
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
# astro sync 的调试日志：vite 会把整个进程环境变量打进去，含 API key / token，永不入库
sync-debug.log
*-debug.log

# 环境变量
.env
.env.*
!.env.example

# 编辑器 / 系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# 抓取回来的第三方页面原始 HTML：只作本地核对用，不随仓库分发
research/raw/

# 工具会话的临时产物（探针脚本、抓取结果、session spill）
.tnega/
.tnega-skills/
