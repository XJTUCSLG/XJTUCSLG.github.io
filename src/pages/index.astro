---
import BaseLayout from '../layouts/BaseLayout.astro';
import NoteRow from '../components/NoteRow.astro';
import EssayRow from '../components/EssayRow.astro';
import { LINKS, SITE } from '../consts';
import { coverageAll, getPostViews } from '../lib/posts';
import { getEssayViews } from '../lib/essays';
import { formatCompactDate } from '../lib/format';
import { STAGE_IDS, STAGES, TRACKS } from '../tracks';

const views = await getPostViews();
const coverage = coverageAll(views);
const essays = await getEssayViews();

const written = views.length;
const lastUpdate = views[0]?.post.data.pubDate;

const latest = views.slice(0, 3);
const recentEssays = essays.slice(0, 2);

/** 方向速览里用的小格：每层已写几篇 */
const cellsOf = (slug: string) =>
  coverage.find((row) => row.track.slug === slug)!.cells;

/** 首页速览不突出 hardware；完整列表仍在 /tracks/ */
const homeTracks = TRACKS.filter((track) => track.slug !== 'hardware');
---

<BaseLayout title="首页" description={SITE.description} isHome>
  <!-- 刊头：身份 + 一句说明 + 一个主入口 -->
  <section class="masthead">
    <div class="container">
      <h1>写给 XJTUer 新生的 101</h1>
      <p class="lead">
        上课偏理论，就业和做项目却要工程这一层。我做了这个站，把命令行、Git、部署这些补上。
      </p>

      <div class="btn-row masthead__actions">
        <a class="btn btn--solid" href="/roadmap/">从第一篇开始</a>
        <a class="btn btn--line" href="/tracks/">方向</a>
      </div>

      {
        lastUpdate && (
          <p class="masthead__updated muted">更新于 {formatCompactDate(lastUpdate)}</p>
        )
      }
    </div>
  </section>

  <!-- 方向速览：名称 + 三层覆盖格 -->
  <section class="band">
    <div class="container">
      <div class="band-head">
        <h2>方向</h2>
        <a href="/tracks/">全部方向</a>
      </div>

      <ul class="track-grid">
        {
          homeTracks.map((track) => {
            const cells = cellsOf(track.slug);
            return (
              <li>
                <div>
                  <a class="track-grid__name" href={`/tracks/${track.slug}/`}>
                    {track.name}
                  </a>
                </div>
                <div class="coverage">
                  {STAGE_IDS.map((stage) => (
                    <span
                      data-filled={cells[stage].length > 0}
                      title={`${STAGES[stage].name}：${cells[stage].length} 篇`}
                    >
                      {cells[stage].length > 0 ? cells[stage].length : '·'}
                    </span>
                  ))}
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <!-- 最近写的 -->
  <section class="band band--tight">
    <div class="container">
      <div class="band-head">
        <h2>最近写的</h2>
        <a href="/blog/">全部笔记（{written} 篇）</a>
      </div>
      <ul class="note-list">
        {latest.map((view) => <NoteRow view={view} showTrack />)}
      </ul>
    </div>
  </section>

  <!-- 随笔 -->
  {
    recentEssays.length > 0 && (
      <section class="band band--tight">
        <div class="container">
          <div class="band-head">
            <h2>随笔</h2>
            <a href="/essays/">全部随笔（{essays.length} 篇）</a>
          </div>
          <ul class="note-list">
            {recentEssays.map((view) => <EssayRow view={view} showTopic />)}
          </ul>
        </div>
      </section>
    )
  }

  <!-- 参与 -->
  <section class="band band--tight">
    <div class="container">
      <p class="note">
        空着的格子可以认领。
        <a href={LINKS.newIssue} rel="noopener">认领这一格</a>
        ，或先看<a href="/about/#write">写作规范</a>。
      </p>
    </div>
  </section>
</BaseLayout>
