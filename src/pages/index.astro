---
import BaseLayout from '../layouts/BaseLayout.astro';
import NoteRow from '../components/NoteRow.astro';
import EssayRow from '../components/EssayRow.astro';
import { LINKS, SITE } from '../consts';
import { coverageAll, getPostViews } from '../lib/posts';
import { getEssayViews } from '../lib/essays';
import { formatCompactDate } from '../lib/format';
import { plannedCount, STAGE_IDS, STAGES, TRACKS } from '../tracks';

const views = await getPostViews();
const coverage = coverageAll(views);
const essays = await getEssayViews();

const written = views.length;
const planned = plannedCount();
const lastUpdate = views[0]?.post.data.pubDate;

/** 每一层挑一篇当入口：概念层优先，没有再退到该层最早的一篇 */
const pickFrom = (stage: (typeof STAGE_IDS)[number]) =>
  views.filter((view) => view.stage === stage).slice(0, 1)[0];

const picks = [
  { label: '先看一篇概念', view: pickFrom('concept') },
  { label: '再照着做一遍', view: pickFrom('practice') },
  { label: '看看贯通层怎么写', view: pickFrom('integration') },
].filter((item) => item.view !== undefined);

const latest = views.slice(0, 4);
const recentEssays = essays.slice(0, 2);

/** 方向速览里用的小格：每层已写几篇 */
const cellsOf = (slug: string) =>
  coverage.find((row) => row.track.slug === slug)!.cells;
---

<BaseLayout title="首页" description={SITE.description} isHome>
  <!-- 刊头：一句话说清补的是什么，然后只给一个入口 -->
  <section class="masthead">
    <div class="container">
      <h1>把工程开发那一半补上</h1>
      <p class="lead">
        课上讲原理，也讲给考试听。这里写另一部分：命令行、版本控制、后端、前端、部署、Agent 工具链——
        写项目每天都要用，却没人开课。每个方向分<b>概念 → 实践 → 贯通</b>三层，一步一步往下走。
      </p>

      <div class="btn-row masthead__actions">
        <a class="btn btn--solid" href="/roadmap/">从第一篇开始读</a>
        <a class="btn btn--line" href="/tracks/">看方向索引</a>
        <a class="btn btn--link" href="/essays/">随笔</a>
      </div>

      <dl class="tally">
        <div>
          <dt>方向</dt>
          <dd>{TRACKS.length}</dd>
        </div>
        <div>
          <dt>已写</dt>
          <dd>{written}</dd>
        </div>
        <div>
          <dt>待写</dt>
          <dd>{planned}</dd>
        </div>
        {
          lastUpdate && (
            <div>
              <dt>更新于</dt>
              <dd>{formatCompactDate(lastUpdate)}</dd>
            </div>
          )
        }
      </dl>
    </div>
  </section>

  <!-- 起步路线：左边是三步，右边是「现在就能点开的三篇」 -->
  <section class="band">
    <div class="container">
      <div class="band-head">
        <h2>第一次来，按这个顺序</h2>
        <a href="/roadmap/">更细的读法</a>
      </div>

      <div class="start-grid">
        <ol class="start-steps">
          <li>
            <h3>读一篇概念</h3>
            <p>
              不急着敲命令。先把「它在解决什么问题」搞清楚，
              后面查文档、看报错都会顺很多。
            </p>
            <p class="start-steps__links">
              <a href="/tracks/env/">从环境和命令行开始 →</a>
            </p>
          </li>
          <li>
            <h3>顺着 环境 → Git → GitHub 往下读</h3>
            <p>
              环境与命令行是其余方向的前置，读完接着看 Git，再看 GitHub 与协作。
              方向内的编号 1.1、1.2 就是阅读顺序。
            </p>
            <p class="start-steps__links">
              <a href="/tracks/">全部 {TRACKS.length} 个方向 →</a>
            </p>
          </li>
          <li>
            <h3>照着做一遍，卡住就记下来</h3>
            <p>
              实践层的每篇都能照着做完。卡住时抄下报错原文去 issue 里问，
              比读完十篇不动手有用。
            </p>
            <p class="start-steps__links">
              <a href="/blog/?stage=practice">只看实践层 →</a>
              <span class="muted">（列表页可按层和方向筛）</span>
            </p>
          </li>
        </ol>

        {
          picks.length > 0 && (
            <div class="pick">
              <p class="pick__head">现在就能打开，共 {picks.length} 篇</p>
              <ul>
                {picks.map((item) => (
                  <li>
                    <a href={item.view!.href}>
                      {item.view!.post.data.title}
                      <span class="pick__meta">
                        {item.label} · {item.view!.track.name} {item.view!.code}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- 方向速览：一屏看完所有方向，每行三个小格 = 三层的篇数 -->
  <section class="band">
    <div class="container">
      <div class="band-head">
        <h2>方向速览</h2>
        <p class="note">
          三个小格依次是概念、实践、贯通。数字是已写篇数，点号表示还空着，
          <a href="/tracks/">去认领空格</a>。
        </p>
      </div>

      <ul class="track-grid">
        {
          TRACKS.map((track) => {
            const cells = cellsOf(track.slug);
            return (
              <li>
                <div>
                  <a class="track-grid__name" href={`/tracks/${track.slug}/`}>
                    {track.name}
                  </a>
                  <span class="track-grid__blurb">{track.blurb}</span>
                </div>
                <div class="coverage">
                  {STAGE_IDS.map((stage) => (
                    <span
                      data-filled={cells[stage].length > 0}
                      title={`${STAGES[stage].name}：${cells[stage].length} 篇`}
                    >
                      {cells[stage].length > 0 ? cells[stage].length : '·'}
                    </span>
                  ))}
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <!-- 最近写的 -->
  <section class="band band--tight">
    <div class="container">
      <div class="band-head">
        <h2>最近写的</h2>
        <a href="/blog/">全部笔记（{written} 篇）</a>
      </div>
      <ul class="note-list">
        {latest.map((view) => <NoteRow view={view} showTrack />)}
      </ul>
    </div>
  </section>

  <!-- 随笔：工程之外的空间 -->
  {
    recentEssays.length > 0 && (
      <section class="band band--tight">
        <div class="container">
          <div class="band-head">
            <h2>随笔</h2>
            <a href="/essays/">全部随笔（{essays.length} 篇）</a>
          </div>
          <p class="note" style="margin-bottom: 0.75rem;">
            工程之外的那部分：怎么选课、怎么安排时间、怎么在信息不足时做决定。
          </p>
          <ul class="note-list">
            {recentEssays.map((view) => <EssayRow view={view} showTopic />)}
          </ul>
        </div>
      </section>
    )
  }

  <!-- 参与的入口收成一行，不再单独占一块 -->
  <section class="band band--tight">
    <div class="container">
      <p class="note">
        缺的那些格子都留在原地，谁先搞明白谁先写。
        <a href={LINKS.newIssue} rel="noopener">开一个 issue 认领</a>，
        或者先看<a href="/about/#write">写作规范</a>。
      </p>
    </div>
  </section>
</BaseLayout>
