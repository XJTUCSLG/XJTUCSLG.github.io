---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EssayRow from '../../components/EssayRow.astro';
import { ESSAY_TOPICS, LINKS } from '../../consts';
import { getEssayViews, groupByTopic } from '../../lib/essays';

const views = await getEssayViews();
const groups = groupByTopic(views, ESSAY_TOPICS);
---

<BaseLayout
  title="随笔"
  description="工程之外的那部分：求学建议、大学生活、心态与杂谈。XJTUCSLG 101 的随笔栏目。"
>
  <div class="container">
    <header class="masthead">
      <h1>随笔</h1>
      <p class="lead">
        工程笔记回答「怎么做」，这里放回答不了的那部分：怎么选课、怎么安排时间、
        怎么在信息不足时做决定，以及一些关于大学生活的碎想法。
      </p>
      <dl class="tally">
        <div>
          <dt>篇数</dt>
          <dd>{views.length}</dd>
        </div>
        <div>
          <dt>栏目</dt>
          <dd>{groups.length}</dd>
        </div>
      </dl>
    </header>
  </div>

  {
    groups.map((group) => (
      <section class="band">
        <div class="container">
          <div class="band-head">
            <h2>{group.topic}</h2>
            <p class="note">{group.views.length} 篇</p>
          </div>
          <ul class="note-list">
            {group.views.map((view) => <EssayRow view={view} />)}
          </ul>
        </div>
      </section>
    ))
  }

  {
    views.length === 0 && (
      <section class="band">
        <div class="container">
          <p class="note">还没有随笔。想写就直接开一个 PR，栏目从「求学 / 生活 / 心态 / 杂谈」里选一个。</p>
        </div>
      </section>
    )
  }

  <section class="band band--tight">
    <div class="container">
      <h2>和工程笔记的区别</h2>
      <p class="note" style="margin-top: 0.5rem;">
        工程笔记（<a href="/blog/">笔记</a>）每条都要能复现：命令、版本、报错写全，不行就重写。
        随笔不承诺这个——它写的是判断和感受，观点可以不同，欢迎在 issue 里反驳。
      </p>
      <div class="btn-row" style="margin-top: 0.75rem;">
        <a class="btn btn--line" href={LINKS.newIssue} rel="noopener">提一个话题</a>
        <a class="btn btn--line" href="/about/#write">写作规范</a>
      </div>
    </div>
  </section>
</BaseLayout>
